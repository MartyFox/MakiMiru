 *
 * SPEC-010: freedesktop Thumbnail Managing Standard CLI for
 * STL/3MF/OBJ. Invoked by tumbler as `makimiru-thumbnailer INPUT
 * OUTPUT SIZE`; writes a PNG to OUTPUT and exits 0, or exits non-zero
 * and writes nothing on any failure. Renders via the same offscreen
 * WebKit + web/main.js page (loaders, auto-framing, SPEC-008 preflight
 * caps) as the previewer (src/viewers/model.js) — go/no-go on this
 * approach was spiked and confirmed viable before this file was
 * written.
 *
 * This runs unattended over every file tumbler finds in a watched
 * folder — a strictly worse threat model than the previewer's
 * one-file-the-user-opened case — so it applies the same
 * SPEC-007 sandbox gating and relies on web/main.js's SPEC-008 preflight
 * caps unchanged. The sandbox-gating logic below is a deliberate,
 * documented duplicate of src/viewers/model.js's _shouldDisableSandbox()
 * (see that file's own comment) rather than a shared import — this is a
 * genuinely separate binary/GResource, not a GJS module the previewer
 * loads, and duplicating ~15 self-contained lines was judged simpler and
 * lower-risk than reaching into the previewer's private module
 * internals or introducing a new shared-library target for one caller.
 * tests/test-thumbnailer-sandbox-parity.sh statically checks the two
 * copies stay structurally in sync.
 */

imports.package.init({
    name: '@PACKAGE_NAME@',
    version: '@PACKAGE_VERSION@',
    prefix: '@prefix@',
    libdir: '@libdir@',
});

imports.gi.versions.Gtk = '3.0';
imports.gi.versions.WebKit2 = '4.1';
const {Gtk, Gdk, GLib, WebKit2, Gio} = imports.gi;
const System = imports.system;

// Deliberately duplicated from src/viewers/model.js — see file header.
// Must match that file's value; tests/test-thumbnailer-cli.sh's parity
// check assumes they agree.
const OVERSIZED_THRESHOLD_BYTES = 100 * 1024 * 1024;

// New constant for this binary: an internal render budget, deliberately
// conservative and independent of tumbler's own configured timeout (not
// assumed/measured against a specific tumbler version here) — the goal
// is simply "always fail on our own terms before anything external
// kills us mid-write." Sized with headroom above the ~9s worst-case
// observed for SPEC-008's zip-bomb fixture tripping its own decompressed-
// byte cap on this VM's software rendering (measured during SPEC-010
// manual testing) — a tighter budget just replaces that cap's clean
// "too large for quick preview" message with a generic "timed out" one,
// still safe either way, but a needlessly worse diagnostic. Override for
// tests via env var.
const DEFAULT_THUMBNAIL_TIMEOUT_MS = 12000;

function _thumbnailTimeoutMs() {
    let override = GLib.getenv('MAKIMIRU_THUMBNAIL_TIMEOUT_MS');
    let parsed = override ? parseInt(override, 10) : NaN;
    return Number.isFinite(parsed) && parsed > 0 ? parsed : DEFAULT_THUMBNAIL_TIMEOUT_MS;
}

const APPARMOR_USERNS_RESTRICT_PATH =
    '/proc/sys/kernel/apparmor_restrict_unprivileged_userns';

function _shouldDisableSandbox() {
    let override = GLib.getenv('MAKIMIRU_FORCE_SANDBOX');
    if (override === '0')
        return true;
    if (override === '1')
        return false;
    let restricted = false;
    try {
        let [ok, contents] = GLib.file_get_contents(APPARMOR_USERNS_RESTRICT_PATH);
        restricted = ok && imports.byteArray.toString(contents).trim() === '1';
    } catch (e) {
        // No such sysctl on this kernel: nothing to work around.
    }
    return restricted || _inForeignSandbox() || !_sandboxProbeSucceeds();
}

// GNOME's thumbnail factory runs us inside its own bwrap sandbox, so WebKit's
// must stay off there (host bug 2026-11-18: every grid thumbnail aborted with
// exit 133). Other thumbnail services (e.g. XFCE's tumbler) don't sandbox us,
// so WebKit's sandbox stays on for them.
//
// We are already inside someone else's sandbox (e.g. GNOME's thumbnail
// factory bwrap) when our user namespace is not the initial one. WebKit's
// own bwrap sandbox assumes a full host view (/sys, /run, namespaces) and
// aborts the process when nested, in more ways than a probe can mimic
// (host: "No permissions to create new namespace"; VM: "Can't find source
// path /sys/block"). Flatpak is excluded: WebKit sandboxes itself there
// through the portal instead of bwrap.
function _inForeignSandbox() {
    if (GLib.file_test('/.flatpak-info', GLib.FileTest.EXISTS))
        return false;
    try {
        let [ok, contents] = GLib.file_get_contents('/proc/self/uid_map');
        let fields = imports.byteArray.toString(contents).trim().split(/\s+/);
        return ok && !(fields.length === 3 && fields[0] === '0' &&
            fields[1] === '0' && fields[2] === '4294967295');
    } catch (e) {
        return false;
    }
}

// Last check: ask bwrap directly whether it can create the namespaces
// WebKit's sandbox needs (catches userns disabled by other means, e.g.
// kernel.unprivileged_userns_clone=0). Duplicated from src/viewers/model.js
// (see test-thumbnailer-sandbox-parity.sh).
function _sandboxProbeSucceeds() {
    try {
        let [, , , status] = GLib.spawn_sync(null,
            ['/usr/bin/bwrap', '--unshare-all', '--ro-bind', '/', '/', '/usr/bin/true'],
            null,
            GLib.SpawnFlags.STDOUT_TO_DEV_NULL | GLib.SpawnFlags.STDERR_TO_DEV_NULL,
            null);
        return status === 0;
    } catch (e) {
        return false;
    }
}

function _formatForPath(path) {
    let m = /\.([a-zA-Z0-9]+)$/.exec(path);
    let ext = m ? m[1].toLowerCase() : '';
    if (ext === '3mf')
        return '3mf';
    if (ext === 'obj')
        return 'obj';
    return 'stl';
}

function _assetMimeType(path) {
    if (path.endsWith('.html'))
        return 'text/html';
    if (path.endsWith('.js'))
        return 'text/javascript';
    return 'application/octet-stream';
}

// SPEC-011 finding, discovered via a real `.deb`-installed test, not
// assumed up front: GNOME's real thumbnail factory runs this binary
// inside a bwrap sandbox with *no* display-server access at all — no
// X11 socket bind-mount, no Wayland socket, /tmp replaced with an
// isolated directory holding only the one input file. `strace` showed
// Gtk.init() failing with "Gtk-WARNING: cannot open display: :0" —
// unrelated to (and only found after fixing) the earlier /usr-path
// finding from SPEC-010; this is a second, independent sandbox
// constraint on top of that one. Fix: spawn a private, throwaway Xvfb
// entirely within this same sandboxed process tree before Gtk.init() —
// fully self-contained, no host display server needed in any context
// (sandboxed or not). Always spawned, never conditional on an inherited
// DISPLAY already looking set — a set-but-dead DISPLAY (exactly what
// the sandbox actually hands us, inherited from the spawning process's
// own environment) is indistinguishable from a working one without
// already attempting the connection Gtk.init() itself would make, so
// "detect and skip" would be equally fragile; unconditional is simpler
// and provably correct in every context, at the cost of common up to
// a couple hundred ms of Xvfb startup overhead even when a real
// display was already available (e.g. this project's own test suite,
// which passes a real DISPLAY=:0 for direct/manual invocation).
//
// Release review (2026-11-17), real bug: this used to pick a display
// number from our PID, poll for the X11 socket file to appear, and stop
// Xvfb with SIGKILL (force_exit). SIGKILL meant Xvfb never removed its
// /tmp/.X11-unix/X<n> socket or /tmp/.X<n>-lock file. Inside GNOME's
// bwrap thumbnail sandbox /tmp is private and thrown away, so that was
// harmless there, but under tumbler on XFCE/MATE (no bwrap) or in our
// own test suite every thumbnail leaked two files into the real /tmp
// (observed: 10 per test run). Worse, the socket poll then passed
// immediately for any PID-derived number whose stale socket was still
// there, before the new Xvfb was listening, and the thumbnail failed.
// Now: Xvfb chooses a free display itself and writes its number to
// stdout (-displayfd 1) only once it accepts connections, and it is
// stopped with SIGTERM so it cleans up after itself.

// makimiru-pregen runs in a terminal, where Xvfb's keymap warnings and
// Mesa's EGL probing messages (inherited by WebKit's web process) are just
// noise; real failures are still reported per file. The single-thumbnail
// path keeps them: they were how the sandbox problems got diagnosed.
let _quiet = false;

function _enableQuietMode() {
    _quiet = true;
    GLib.setenv('EGL_LOG_LEVEL', 'fatal', false);
}

// Iterates ctx (default: the default main context) until done() or the
// deadline — used outside the real main loop, where we still need async
// subprocess I/O to make progress.
function _iterateUntil(done, timeoutMs, ctx = GLib.MainContext.default()) {
    const deadline = GLib.get_monotonic_time() + timeoutMs * 1000;
    while (!done() && GLib.get_monotonic_time() < deadline) {
        if (!ctx.iteration(false))
            GLib.usleep(10 * 1000);
    }
    return done();
}

function _startPrivateXServer() {
    // Deliberately inherit stderr rather than silencing it — Xvfb
    // rarely prints anything in normal operation, but when it does
    // (or fails to start), that diagnostic was what this project used
    // to actually root-cause the sandbox rendering issues below; worth
    // keeping visible rather than swallowed. stdout is piped: it only
    // carries the -displayfd readiness line.
    const launcher = new Gio.SubprocessLauncher({
        flags: Gio.SubprocessFlags.STDOUT_PIPE |
            (_quiet ? Gio.SubprocessFlags.STDERR_SILENCE : 0),
    });
    let proc;
    try {
        // Real bug, caught by an actual grid-thumbnail screenshot (not
        // by any automated test — solid-black output, not a crash or
        // error, so nothing here threw): a 64x64 screen produced
        // thumbnails that "worked" (exit 0, correctly-sized PNG) but
        // rendered as flat black, because the requested thumbnail size
        // (up to 256, per the freedesktop spec's largest standard size)
        // exceeds Xvfb's own root screen size — offscreen rendering
        // larger than the X screen silently fails to composite instead
        // of erroring. Sized well above any size this project asks for.
        // -terminate: Xvfb exits by itself once its last client
        // disconnects, so it can't be orphaned if tumbler (or anything
        // else) kills us mid-render, before _stopPrivateXServer() runs.
        proc = launcher.spawnv(['Xvfb', '-displayfd', '1', '-terminate',
            '-screen', '0', '1024x1024x24', '-nolisten', 'tcp']);
    } catch (e) {
        printerr(`makimiru-thumbnailer: failed to spawn Xvfb: ${e}`);
        return null;
    }

    const stdout = new Gio.DataInputStream({base_stream: proc.get_stdout_pipe()});
    let displayNum = null;
    let readDone = false;
    stdout.read_line_async(GLib.PRIORITY_DEFAULT, null, (s, res) => {
        try {
            const [line] = s.read_line_finish_utf8(res);
            if (line && /^\d+$/.test(line.trim()))
                displayNum = line.trim();
        } catch (e) {
            printerr(`makimiru-thumbnailer: reading Xvfb display number failed: ${e}`);
        }
        readDone = true;
    });

    if (!_iterateUntil(() => readDone, 5000) || displayNum === null) {
        printerr('makimiru-thumbnailer: Xvfb did not become ready in time');
        proc.force_exit();
        return null;
    }

    GLib.setenv('DISPLAY', `:${displayNum}`, true);
    return proc;
}

// SIGTERM (not SIGKILL) so Xvfb removes its own socket and lock file;
// SIGKILL only as a fallback if it hasn't exited within 2 s.
//
// The wait runs on a private main context, never the default one:
// GTK's X connection lives on the default context, and once Xvfb exits
// GDK treats the dropped connection as fatal and calls exit(1) — which
// is exactly what happened when this first iterated the default context
// (every sandboxed thumbnail "failed" after rendering successfully;
// caught by test-deb-install.sh's real Nautilus run). Not dispatching
// the default context means GDK never sees the hang-up before we exit.
function _stopPrivateXServer(proc) {
    const ctx = new GLib.MainContext();
    let exited = false;
    ctx.push_thread_default();
    try {
        proc.wait_async(null, () => {
            exited = true;
        });
        proc.send_signal(15);
    } catch (e) {
        ctx.pop_thread_default();
        return;
    }
    ctx.pop_thread_default();
    if (!_iterateUntil(() => exited, 2000, ctx))
        proc.force_exit();
    _removeOwnX11Dir();
}

// Xvfb creates /tmp/.X11-unix for its socket but never removes the
// directory itself. Inside GNOME's thumbnail sandbox /tmp is a fresh
// per-thumbnail host directory (/tmp/gnome-desktop-thumbnailer-XXXXXX)
// that gnome-desktop deletes afterwards — and refuses to delete when we
// leave anything in it ("thumbnailer ... left files in directory"),
// leaking one such directory into the real /tmp per thumbnail. Remove
// it only when it's ours and empty: on a normal desktop /tmp/.X11-unix
// is root-owned and shared, so the uid check leaves it alone, and
// delete() refuses a non-empty directory anyway.
function _removeOwnX11Dir() {
    try {
        const uidOf = (path, flags) => Gio.File.new_for_path(path)
            .query_info('unix::uid', flags, null)
            .get_attribute_uint32('unix::uid');
        const dir = '/tmp/.X11-unix';
        // /proc/self is a root-owned symlink: follow it to our own
        // /proc/<pid>, which is owned by our uid.
        const ourUid = uidOf('/proc/self', Gio.FileQueryInfoFlags.NONE);
        if (uidOf(dir, Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS) === ourUid)
            Gio.File.new_for_path(dir).delete(null);
    } catch (e) { /* absent, not ours, or not empty — leave it */ }
}

// ---- Rendering ------------------------------------------------------------
// One offscreen WebView renders any number of models in turn. The single-
// file CLI uses it once; --pregen reuses it for a whole folder — one Xvfb
// and one WebKit web process for every file, instead of starting both per
// thumbnail (that start-up is most of a thumbnail's time). The makimiru://
// scheme serves the bundled web/ assets plus the *current* job's file at
// the reserved /model path; no request parameter can pick a different file.

function _serveModel(request, file) {
    if (!file) {
        request.finish_error(new GLib.Error(
            Gio.IOErrorEnum, Gio.IOErrorEnum.NOT_FOUND, 'no model'));
        return;
    }
    file.read_async(GLib.PRIORITY_DEFAULT, null, (f, res) => {
        try {
            request.finish(f.read_finish(res), -1, 'application/octet-stream');
        } catch (e) {
            request.finish_error(new GLib.Error(
                Gio.IOErrorEnum, Gio.IOErrorEnum.FAILED, 'model read failed'));
        }
    });
}

function _serveAsset(request, webDir, path) {
    let rel = path.replace(/^\/+/, '');
    if (rel === '')
        rel = 'viewer.html';
    const target = GLib.build_filenamev([webDir, rel]);
    if (target !== webDir && !target.startsWith(webDir + '/')) {
        request.finish_error(new GLib.Error(
            Gio.IOErrorEnum, Gio.IOErrorEnum.NOT_FOUND, 'out of bounds'));
        return;
    }
    Gio.File.new_for_path(target).read_async(GLib.PRIORITY_DEFAULT, null, (f, res) => {
        try {
            request.finish(f.read_finish(res), -1, _assetMimeType(target));
        } catch (e) {
            request.finish_error(new GLib.Error(
                Gio.IOErrorEnum, Gio.IOErrorEnum.NOT_FOUND, 'asset not found'));
        }
    });
}

// A render job finishes exactly once: with a pixbuf, a failure reason, or
// a timeout of its own (so one bad file can't stall a whole batch).
// `permanent` marks failures that retrying the same file won't fix.
// The id goes into the page URL and comes back on every page message, so
// a message from the previous job's page is never taken for this job's.
let _nextJobId = 1;

function _newJob(file, done) {
    const job = {id: String(_nextJobId++), file, finished: false, timeoutId: 0};
    job.finish = (pixbuf, reason, permanent = false) => {
        if (job.finished)
            return;
        job.finished = true;
        if (job.timeoutId)
            GLib.source_remove(job.timeoutId);
        done(pixbuf, reason, permanent);
    };
    job.timeoutId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, _thumbnailTimeoutMs(), () => {
        job.timeoutId = 0;
        job.finish(null, 'render timed out');
        return GLib.SOURCE_REMOVE;
    });
    return job;
}

// WebKit's own snapshot API, not Gtk.OffscreenWindow.get_pixbuf(): the
// latter silently captured a blank frame inside GNOME's thumbnail sandbox
// (SPEC-011). The 100 ms settle before calling this is also deliberate:
// capturing immediately on 'rendered' can catch a not-yet-composited frame.
function _snapshot(view, size, job) {
    if (job.finished)
        return;
    view.get_snapshot(WebKit2.SnapshotRegion.VISIBLE, WebKit2.SnapshotOptions.NONE, null,
        (v, res) => {
            try {
                const surface = v.get_snapshot_finish(res);
                const pixbuf = Gdk.pixbuf_get_from_surface(surface, 0, 0, size, size);
                job.finish(pixbuf, pixbuf ? null : 'snapshot produced no image');
            } catch (e) {
                job.finish(null, `get_snapshot failed: ${e}`);
            }
        });
}

function _createView(context, contentManager, size) {
    const view = new WebKit2.WebView({
        web_context: context,
        user_content_manager: contentManager,
    });
    view.set_size_request(size, size);
    const win = new Gtk.OffscreenWindow();
    win.add(view);
    win.show_all();
    return view;
}

// The job id a makimiru:// URI carries (?job= / &job=), or null.
function _jobIdOf(uri) {
    const m = /[?&]job=(\d+)/.exec(uri || '');
    return m ? m[1] : null;
}

// Routes the page's messages and WebView failures to the current job. All
// three channels (messages, load-failed, /model requests in
// _createRenderer) are matched by job id, so nothing from a previous job's
// page can reach the current one.
function _connectJobEvents(view, contentManager, size, currentJob) {
    contentManager.connect('script-message-received::makimiru', (cm, jsResult) => {
        const job = currentJob();
        let msg;
        try {
            msg = JSON.parse(jsResult.get_js_value().to_string());
        } catch (e) {
            return;
        }
        if (!job || msg.job !== job.id)
            return;
        if (msg.event === 'rendered') {
            GLib.timeout_add(GLib.PRIORITY_DEFAULT, 100, () => {
                _snapshot(view, size, job);
                return GLib.SOURCE_REMOVE;
            });
        } else if (msg.event === 'error') {
            // badFile: the page read the file but can't use its contents,
            // so a retry would fail too. Anything else (no WebGL, read
            // error, page script failure) may be the environment.
            job.finish(null, `page error: ${msg.message}`, msg.badFile === true);
        }
    });
    view.connect('load-failed', (v, ev, uri, error) => {
        const job = currentJob();
        if (job && _jobIdOf(uri) === job.id)
            job.finish(null, `load-failed: ${error.message}`);
        return false;
    });
    view.connect('web-process-terminated', (v, reason) => {
        currentJob()?.finish(null, `web process terminated: ${reason}`);
    });
}

function _createRenderer(size) {
    const webDir = GLib.build_filenamev([pkg.pkgdatadir, 'web']);
    const context = new WebKit2.WebContext();
    context.set_sandbox_enabled(!_shouldDisableSandbox());
    let job = null;
    context.register_uri_scheme('makimiru', (request) => {
        const path = request.get_path() || '/';
        if (path === '/model')
            _serveModel(request, job && _jobIdOf(request.get_uri()) === job.id ? job.file : null);
        else
            _serveAsset(request, webDir, path);
    });

    const contentManager = new WebKit2.UserContentManager();
    contentManager.register_script_message_handler('makimiru');
    const view = _createView(context, contentManager, size);
    _connectJobEvents(view, contentManager, size, () => job);

    return {
        // Calls done(pixbuf) or done(null, reason, permanent) exactly once.
        // A finished job ignores late events, so it can stay current until
        // the next.
        render(file, done) {
            job = _newJob(file, done);
            view.load_uri('makimiru://app/viewer.html?model=' +
                encodeURIComponent(`makimiru://app/model?job=${job.id}`) +
                '&format=' + _formatForPath(file.get_basename() || '') +
                '&job=' + job.id);
        },
    };
}

// Private X server + GTK, or null (reason already printed).
function _startDisplay() {
    const xServer = _startPrivateXServer();
    if (!xServer) {
        printerr('makimiru-thumbnailer: could not start a private display — cannot render');
        return null;
    }
    try {
        Gtk.init(null);
    } catch (e) {
        printerr(`makimiru-thumbnailer: Gtk.init failed: ${e}`);
        _stopPrivateXServer(xServer);
        return null;
    }
    return xServer;
}

// Runs start(renderer, quit) inside a main loop on a private display and
// returns the code passed to quit(). start runs from idle, so it may call
// quit() straight away without the quit being lost before loop.run().
function _runRenderLoop(size, start) {
    const xServer = _startDisplay();
    if (!xServer)
        return 1;
    const loop = GLib.MainLoop.new(null, false);
    let exitCode = 1;
    const renderer = _createRenderer(size);
    GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
        start(renderer, (code) => {
            exitCode = code;
            loop.quit();
        });
        return GLib.SOURCE_REMOVE;
    });
    loop.run();
    _stopPrivateXServer(xServer);
    return exitCode;
}

function _sizeProblem(bytes) {
    return bytes >= OVERSIZED_THRESHOLD_BYTES ? 'file too large for a quick thumbnail' : null;
}

// Returns null when the file can be rendered, else why not.
function _cannotRender(file) {
    try {
        return _sizeProblem(
            file.query_info('standard::size', Gio.FileQueryInfoFlags.NONE, null).get_size());
    } catch (e) {
        return `cannot stat input: ${e}`;
    }
}

// ---- Single thumbnail (GNOME's thumbnail factory, tumbler) -----------------

// Atomic write: whatever reads outputPath (GNOME's thumbnail factory, in
// real use) never observes a partial file.
function _savePngAtomic(pixbuf, outputPath) {
    const tmpPath = `${outputPath}.tmp-${GLib.random_int()}`;
    try {
        if (!pixbuf.savev(tmpPath, 'png', [], []))
            throw new Error('pixbuf save failed');
        Gio.File.new_for_path(tmpPath).move(
            Gio.File.new_for_path(outputPath), Gio.FileCopyFlags.OVERWRITE, null, null);
        return true;
    } catch (e) {
        printerr(`makimiru-thumbnailer: writing output failed: ${e}`);
        try {
            Gio.File.new_for_path(tmpPath).delete(null);
        } catch (e2) { /* nothing to clean up */ }
        return false;
    }
}

function _thumbnailOne(args) {
    if (args.length !== 3) {
        printerr('usage: makimiru-thumbnailer INPUT OUTPUT SIZE');
        return 1;
    }
    const [inputArg, outputPath, sizeArg] = args;
    // %i (path) or %u (URI), depending on the .thumbnailer Exec= line.
    const inputFile = inputArg.includes('://')
        ? Gio.File.new_for_uri(inputArg)
        : Gio.File.new_for_path(inputArg);
    let size = parseInt(sizeArg, 10);
    if (!Number.isFinite(size) || size <= 0)
        size = 256;

    const reason = _cannotRender(inputFile);
    if (reason) {
        printerr(`makimiru-thumbnailer: ${reason}`);
        return 1;
    }
    return _runRenderLoop(size, (renderer, quit) => {
        renderer.render(inputFile, (pixbuf, why) => {
            if (!pixbuf) {
                printerr(`makimiru-thumbnailer: ${why}`);
                quit(1);
                return;
            }
            quit(_savePngAtomic(pixbuf, outputPath) ? 0 : 1);
        });
    });
}

// ---- Batch pre-generation (makimiru-pregen) ---------------------------------
// Fills GNOME's own thumbnail cache ahead of time, so a big folder of
// models opens with every thumbnail already there. Saving goes through
// GnomeDesktop.DesktopThumbnailFactory, the same code Files uses, so the
// PNGs land at the path Files looks up, with the Thumb::URI/MTime metadata
// it checks — and failures are recorded the way Files records them, so it
// won't retry them either. Runs in the user's session, not GNOME's
// thumbnail sandbox; WebKit's own sandbox is still applied when available
// (_shouldDisableSandbox).

const PREGEN_USAGE =
    'usage: makimiru-pregen [--size normal|large|x-large|xx-large] [--notify] FOLDER...';
// Files 46 uses "large" (256 px) at default zoom; bigger zoom levels and
// HiDPI screens use the larger sizes.
const PREGEN_SIZES = {
    'normal': ['NORMAL', 128], 'large': ['LARGE', 256],
    'x-large': ['XLARGE', 512], 'xx-large': ['XXLARGE', 1024],
};
const MODEL_FILE_RE = /\.(stl|3mf|obj)$/i;

function _parsePregenArgs(args) {
    const opts = {size: 'large', notify: false, paths: []};
    for (let i = 0; i < args.length; i++) {
        const arg = args[i];
        if (arg === '--') {
            opts.paths.push(...args.slice(i + 1));
            break;
        }
        if (arg === '--size' && i + 1 < args.length)
            opts.size = args[++i];
        else if (arg === '--notify')
            opts.notify = true;
        else if (arg.startsWith('-'))
            return null;
        else
            opts.paths.push(arg);
    }
    return PREGEN_SIZES[opts.size] && opts.paths.length ? opts : null;
}

const COLLECT_ATTRS =
    'standard::name,standard::type,standard::is-hidden,standard::size,time::modified';

function _visitModels(file, info, found) {
    const type = info.get_file_type();
    if (type === Gio.FileType.REGULAR && MODEL_FILE_RE.test(info.get_name())) {
        found.push({file, size: info.get_size(),
            mtime: info.get_attribute_uint64('time::modified')});
    }
    if (type !== Gio.FileType.DIRECTORY)
        return;
    for (const [child, childInfo] of _visibleChildren(file))
        _visitModels(child, childInfo, found);
}

// A folder's non-hidden entries as [file, info] pairs. The enumerator is
// closed before the caller recurses (GC won't run during this synchronous
// walk), so a deep tree holds one directory fd at a time, not one per level.
function _visibleChildren(dir) {
    let children;
    try {
        children = dir.enumerate_children(COLLECT_ATTRS, Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, null);
    } catch (e) {
        printerr(`makimiru-pregen: cannot read ${dir.get_path()}: ${e.message}`);
        return [];
    }
    const entries = [];
    try {
        for (let info; (info = children.next_file(null));) {
            if (!info.get_is_hidden())
                entries.push([children.get_child(info), info]);
        }
    } finally {
        children.close(null);
    }
    return entries;
}

// Model files under the given paths, recursively. Hidden entries inside a
// folder are skipped. A symlink given as a path is followed (a symlinked
// folder is still the folder the user picked); symlinks found inside are
// not (no loops).
function _collectModels(paths) {
    const found = [];
    for (const path of paths) {
        const file = Gio.File.new_for_commandline_arg(path);
        try {
            const info = file.query_info(COLLECT_ATTRS, Gio.FileQueryInfoFlags.NONE, null);
            _visitModels(file, info, found);
        } catch (e) {
            printerr(`makimiru-pregen: cannot read ${path}: ${e.message}`);
        }
    }
    return found;
}

function _notify(summary, body) {
    try {
        Gio.DBus.session.call_sync('org.freedesktop.Notifications',
            '/org/freedesktop/Notifications', 'org.freedesktop.Notifications', 'Notify',
            new GLib.Variant('(susssasa{sv}i)',
                ['MakiMiru', 0, 'image-x-generic', summary, body, [], {}, -1]),
            null, Gio.DBusCallFlags.NONE, 5000, null);
    } catch (e) {
        printerr(`makimiru-pregen: desktop notification failed: ${e.message}`);
    }
}

// Splits found models into ones still to render and a count already handled
// (cached, previously failed, or recorded as failed now because too large).
// Overlapping arguments (a folder and its subfolder) list a file twice; it
// is rendered once.
function _triage(factory, models, stats) {
    const todo = [];
    const seen = new Set();
    for (const found of models) {
        const m = {...found, uri: found.file.get_uri()};
        if (seen.has(m.uri))
            continue;
        seen.add(m.uri);
        if (factory.lookup(m.uri, m.mtime) || factory.has_valid_failed_thumbnail(m.uri, m.mtime)) {
            stats.cached++;
            continue;
        }
        const reason = _sizeProblem(m.size);
        if (reason)
            _recordFailure(factory, m, reason, true, stats);
        else
            todo.push(m);
    }
    return todo;
}

// Permanent failures (too large, or contents the page can't use) are
// recorded the way Files records them, so neither Files nor a later run
// retries them. Others (timeout, crash, snapshot or save error) may be
// transient: reported only, so the next run or Files tries again.
function _recordFailure(factory, model, reason, permanent, stats) {
    stats.failed++;
    print(`failed  ${model.file.get_path()}: ${reason}${permanent ? '' : ' (will retry)'}`);
    if (!permanent)
        return;
    try {
        factory.create_failed_thumbnail(model.uri, model.mtime, null);
    } catch (e) {
        printerr(`makimiru-pregen: could not record failure: ${e.message}`);
    }
}

function _saveToCache(factory, model, pixbuf, stats) {
    try {
        factory.save_thumbnail(pixbuf, model.uri, model.mtime, null);
        stats.made++;
        print(`made    ${model.file.get_path()}`);
    } catch (e) {
        _recordFailure(factory, model, e.message, false, stats);
    }
}

// Renders todo in order on one display. Returns 1, rendering nothing, only
// when the display can't start.
function _renderAll(factory, todo, pixels, stats) {
    return _runRenderLoop(pixels, (renderer, quit) => {
        const next = (i) => {
            const m = todo[i];
            if (!m) {
                quit(0);
                return;
            }
            renderer.render(m.file, (pixbuf, reason, permanent) => {
                if (pixbuf)
                    _saveToCache(factory, m, pixbuf, stats);
                else
                    _recordFailure(factory, m, reason, permanent, stats);
                next(i + 1);
            });
        };
        next(0);
    });
}

function _pregen(args) {
    const opts = _parsePregenArgs(args);
    if (!opts) {
        printerr(PREGEN_USAGE);
        return 2;
    }
    _enableQuietMode();
    imports.gi.versions.GnomeDesktop = '3.0';
    const GnomeDesktop = imports.gi.GnomeDesktop;
    const [sizeName, pixels] = PREGEN_SIZES[opts.size];
    const factory = GnomeDesktop.DesktopThumbnailFactory.new(
        GnomeDesktop.DesktopThumbnailSize[sizeName]);

    const started = GLib.get_monotonic_time();
    const stats = {made: 0, cached: 0, failed: 0};
    const todo = _triage(factory, _collectModels(opts.paths), stats);
    const code = todo.length ? _renderAll(factory, todo, pixels, stats) : 0;
    if (code !== 0)
        stats.failed += todo.length; // no display: none rendered, none recorded

    const secs = ((GLib.get_monotonic_time() - started) / 1e6).toFixed(1);
    const summary = `${stats.made} new, ${stats.cached} already done, ${stats.failed} failed`;
    print(`makimiru-pregen: ${summary} (${secs} s)`);
    if (opts.notify)
        _notify('3D thumbnails ready', summary);
    return code;
}

function main() {
    const code = ARGV[0] === '--pregen' ? _pregen(ARGV.slice(1)) : _thumbnailOne(ARGV);
    System.exit(code);
}

main();
